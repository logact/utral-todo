{
  "name": "utral-todo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:all": "concurrently \"pnpm server:dev\" \"pnpm desktop:dev\" --names server,vite --prefix-colors cyan,green",

    "server:dev": "pnpm --filter server dev",
    "server:build": "pnpm --filter server build",

    "cli:build": "pnpm --filter cli build",

    "desktop:dev": "pnpm --filter desktop tauri:dev",
    "desktop:build": "pnpm --filter desktop tauri:build",

    "expo:dev": "pnpm --filter expo-app start",
    "expo:dev:ios": "pnpm --filter expo-app start --ios",
    "expo:build": "pnpm --filter expo-app typecheck",

    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:push": "pnpm --filter server db:push",
    "db:studio": "pnpm --filter server db:studio",

    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache",
    "cli": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "~6.0.2"
  }
}
