{
  "name": "utral-todo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:server": "pnpm --filter server dev",
    "dev:cli": "pnpm --filter cli dev",
    "dev:all": "concurrently \"pnpm dev:server\" \"pnpm dev:desktop\" --names server,vite --prefix-colors cyan,green",
    "dev:expo": "pnpm --filter expo-app start",
    "dev:expo:ios": "pnpm --filter expo-app start --ios",
    
    "build:expo": "pnpm --filter expo-app typecheck",
    "tauri:dev": "pnpm --filter desktop tauri:dev",
    "tauri:build": "pnpm --filter desktop tauri:build",
    "build": "pnpm -r build",

    "build:desktop": "pnpm --filter desktop build",
    "build:server": "pnpm --filter server build",
    "build:cli": "pnpm --filter cli build",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:push": "pnpm --filter server db:push",
    "db:studio": "pnpm --filter server db:studio",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache",
    "cli": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "~6.0.2"
  }
}
