{
  "name": "@utral/db-schema",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./src/store.ts",
      "default": "./dist/store.js"
    },
    "./id": {
      "types": "./src/id.ts",
      "default": "./dist/id.js"
    },
    "./storage": {
      "types": "./src/storage.ts",
      "default": "./dist/storage.js"
    },
    "./timeslots": {
      "types": "./src/timeSlotEngine.ts",
      "default": "./dist/timeSlotEngine.js"
    },
    "./bootstrap": {
      "types": "./src/bootstrap.ts",
      "default": "./dist/bootstrap.js"
    },
    "./todo-ops": {
      "types": "./src/todoOps.ts",
      "default": "./dist/todoOps.js"
    },
    "./pluse-ops": {
      "types": "./src/pluseOps.ts",
      "default": "./dist/pluseOps.js"
    },
    "./plan-ops": {
      "types": "./src/planOps.ts",
      "default": "./dist/planOps.js"
    },
    "./relation-ops": {
      "types": "./src/relationOps.ts",
      "default": "./dist/relationOps.js"
    },
    "./action-edge-ops": {
      "types": "./src/actionEdgeOps.ts",
      "default": "./dist/actionEdgeOps.js"
    },
    "./todo-log-ops": {
      "types": "./src/todoLogOps.ts",
      "default": "./dist/todoLogOps.js"
    },
    "./repeat-occurrence-ops": {
      "types": "./src/repeatOccurrenceOps.ts",
      "default": "./dist/repeatOccurrenceOps.js"
    },
    "./label-ops": {
      "types": "./src/labelOps.ts",
      "default": "./dist/labelOps.js"
    }
  },
  "scripts": {
    "prebuild": "rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@utral/types": "workspace:*",
    "@utral/sync-client": "workspace:*",
    "@utral/sync-share": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.44.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "typescript": "~6.0.2"
  }
}
