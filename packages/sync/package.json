{
  "name": "@utral/sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/dexie": {
      "types": "./dist/client/dexie-storage.d.ts",
      "default": "./dist/client/dexie-storage.js"
    },
    "./client/drizzle": {
      "types": "./dist/client/drizzle-storage.d.ts",
      "default": "./dist/client/drizzle-storage.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/prisma": {
      "types": "./dist/server/prisma-storage.d.ts",
      "default": "./dist/server/prisma-storage.js"
    },
    "./server/drizzle-pg": {
      "types": "./dist/server/drizzle-pg-storage.d.ts",
      "default": "./dist/server/drizzle-pg-storage.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@utral/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "dexie": "^4.0.0",
    "drizzle-orm": "^0.44.0",
    "@prisma/client": "^6.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "dexie": { "optional": true },
    "drizzle-orm": { "optional": true },
    "@prisma/client": { "optional": true },
    "pg": { "optional": true }
  }
}
