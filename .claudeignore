# Claude Code / AI Context Management
# Files and directories listed here are excluded from the AI context window
# This prevents large/generated files from inflating token usage every turn

# ============================================
# CRITICAL: Build artifacts & generated files
# ============================================
# Rust / Tauri (desktop app)
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/Cargo.lock

# iOS / Xcode build index
apps/ios/UtralTodoKit/.build/
*.xcworkspace/
*.xcuserdata/
DerivedData/

# Vite / bundler caches
**/.vite/

# Graphify code analysis output (massive AST dumps)
graphify-out/
.graphify_*

# ============================================
# Package manager lock files (very large, no code value)
# ============================================
pnpm-lock.yaml
package-lock.json
yarn.lock
*.lock

# ============================================
# Build outputs & compiled files
# ============================================
node_modules/
dist/
build/
.out/
.next/
.tauri/
**/*.tsbuildinfo

# Server compiled output
apps/server/dist/

# CLI compiled output
apps/cli/dist/

# Mobile compiled output
apps/mobile/dist/

# ============================================
# Large data files & databases
# ============================================
*.csv
*.jsonl
*.log
*.sqlite
*.sqlite3
*.db

# SQLite databases (specific paths in this project)
apps/server/prisma/**/database.sqlite
apps/server/prisma/**/database.sqlite-journal

# ============================================
# Session artifacts & Kimi agent metadata
# ============================================
# Kimi agent generates session directories + zip exports
session_*
session_*/
*.zip

# Agent logs and metadata (if outside session dirs)
.agents/
logs/kimi-code.log

# ============================================
# Environment & config files (sensitive / irrelevant)
# ============================================
.env
.env.*
!.env.example

# ============================================
# IDE / local files
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# Test & coverage
# ============================================
coverage/

# ============================================
# Temp files
# ============================================
tmp/
temp/

# ============================================
# Large planning documents (reference-only)
# ============================================
planning/
docs/

# Large demo files
*.demo.html
fitness_road_to_goal_demo.html

# ============================================
# Git / system files
# ============================================
.git/
.gitignore
.DS_Store
