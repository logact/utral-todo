DATABASE_URL=file:/var/lib/utral-todo/data/utraltodo.sqlite
API_TOKEN=

# Apple Push Notification Service (APNS) configuration
# Required for iOS and watchOS background sync notifications
# Get these from Apple Developer Portal: https://developer.apple.com/account/resources/authkeys/list
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=
# Set to 'true' for development/sandbox, omit or 'false' for production
APNS_SANDBOX=true
