generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   // 'active' | 'archived'
  color       String
  createdAt   DateTime @default(now())
  deadline    DateTime?
  todos       Todo[]
}

model Todo {
  id               String         @id @default(uuid())
  projectId        String?
  parentId         String?
  title            String
  description      String         @default("")
  instructions     String         @default("")
  status           String         // 'pending' | 'in_progress' | 'done'
  priority         String         // 'low' | 'medium' | 'high'
  estimatedMinutes Int            @default(60)
  tags             Json           @default("[]")
  createdAt        DateTime       @default(now())
  dueDate          DateTime?
  scheduledDate    DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  repeatRule       Json?
  order            Int            @default(0)
  isGoal           Boolean        @default(false)

  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent           Todo?          @relation("TodoChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children         Todo[]         @relation("TodoChildren")

  outgoingRelations TodoRelation[] @relation("FromTodo")
  incomingRelations TodoRelation[] @relation("ToTodo")

  logs             TodoLog[]
}

model TodoRelation {
  id         String   @id @default(uuid())
  fromTodoId String
  toTodoId   String
  type       String
  createdAt  DateTime @default(now())

  fromTodo   Todo     @relation("FromTodo", fields: [fromTodoId], references: [id], onDelete: Cascade)
  toTodo     Todo     @relation("ToTodo", fields: [toTodoId], references: [id], onDelete: Cascade)
}

model TodoLog {
  id           String   @id @default(uuid())
  todoId       String
  type         String   // 'progress' | 'thought' | 'blocker' | 'decision' | 'system' | 'step_complete'
  content      String
  minutesSpent Int?
  metadata     Json?
  createdAt    DateTime @default(now())

  todo         Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
}

model TimerSession {
  id             String   @id @default(uuid())
  type           String   // 'stopwatch' | 'pluse'
  name           String
  pluseId        String?
  todoId         String?
  intervals      Json?    // number[] for pluse type
  repeatCount    Int      @default(1)
  startedAt      DateTime @default(now())
  pausedAt       DateTime?
  completedAt    DateTime?
  currentIndex   Int      @default(0)
  elapsedSeconds Int      @default(0)
  status         String   // 'running' | 'paused' | 'completed'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Roadmap {
  id        String   @id @default(uuid())
  goalTodoId String  @unique
  phases    Json     // RoadmapPhase[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActionEdge {
  id        String   @id @default(uuid())
  fromTodoId String
  toTodoId  String
  type      String   // 'insight' | 'try' | 'pre_do'
  createdAt DateTime @default(now())
}

model Pluse {
  id           String   @id @default(uuid())
  name         String
  description  String   @default("")
  intervals    Json     // number[]
  repeatCount  Int      @default(1)
  createdAt    DateTime @default(now())
}
