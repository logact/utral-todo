generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Todo {
  id               String         @id @default(uuid())
  nodeType         String         @default("task") // 'goal' | 'task'
  pattern          String         @default("task") // 'task' | 'cognitive'
  parentId         String?
  title            String
  description      String         @default("")
  status           String?        // 'pending' | 'in_progress' | 'done' — null for goals
  priority         String?        // 'low' | 'medium' | 'high' — null for goals
  estimatedMinutes Int?           // null for goals
  tags             Json           @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  dueDate          DateTime?
  scheduledDate    DateTime?
  scheduledEndDate DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  repeatRule       Json?
  order            Int            @default(0)

  // Goal fields
  motivation       String?
  successCriteria  String?
  targetDate       DateTime?
  goalStatus       String?        // 'active' | 'paused' | 'achieved' | 'abandoned'
  activePlanId     String?
  isRootGoal       Boolean?       @default(false)
  isSystemTask     Boolean?       @default(false)

  parent           Todo?          @relation("TodoChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children         Todo[]         @relation("TodoChildren")

  outgoingRelations TodoRelation[] @relation("FromTodo")
  incomingRelations TodoRelation[] @relation("ToTodo")

  logs             TodoLog[]
}

model TodoRelation {
  id         String   @id @default(uuid())
  fromTodoId String
  toTodoId   String
  type       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromTodo   Todo     @relation("FromTodo", fields: [fromTodoId], references: [id], onDelete: Cascade)
  toTodo     Todo     @relation("ToTodo", fields: [toTodoId], references: [id], onDelete: Cascade)
}

model TodoLog {
  id           String   @id @default(uuid())
  todoId       String
  type         String   // 'progress' | 'thought' | 'blocker' | 'decision' | 'system' | 'step_complete'
  content      String
  minutesSpent Int?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  todo         Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
}

model TimerSession {
  id             String   @id @default(uuid())
  type           String   // 'stopwatch' | 'pluse'
  name           String
  pluseId        String?
  todoId         String?
  intervals      Json?    // number[] for pluse type
  repeatCount    Int      @default(1)
  startedAt      DateTime @default(now())
  pausedAt       DateTime?
  completedAt    DateTime?
  currentIndex   Int      @default(0)
  elapsedSeconds Int      @default(0)
  status         String   // 'running' | 'paused' | 'completed'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Plan {
  id         String   @id @default(uuid())
  goalTodoId String
  title      String
  nodeIds    Json     // string[]
  edgeIds    Json     // string[]
  isSystemPlan Boolean? @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([goalTodoId])
}

model ActionEdge {
  id         String   @id @default(uuid())
  fromTodoId String
  toTodoId   String
  type       String   // 'pre_do' | 'parent_child' | 'to_achieve' (legacy: 'insight' | 'try')
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Pluse {
  id            String   @id @default(uuid())
  name          String
  description   String   @default("")
  intervals     Json     // number[]
  repeatCount   Int      @default(1)
  intervalTodos Json?    // Record<number, string>
  autoAdvance   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RepeatOccurrence {
  id               String   @id
  templateId       String
  date             DateTime
  status           String
  completedAt      DateTime?
  materializedTodoId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([templateId])
  @@index([date])
}

model SyncEvent {
  id        String   @id @default(uuid())
  table     String
  operation String   // 'create' | 'update' | 'delete'
  recordId  String
  payload   Json?
  deviceId  String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([recordId])
}

model Device {
  id         String   @id @default(uuid())
  deviceId   String   @unique
  platform   String   // 'ios' | 'watchos' | 'desktop'
  name       String?
  pushToken  String?
  appVersion String?
  lastSeenAt DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([platform])
  @@index([pushToken])
}
