generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Todo {
  id               String         @id @default(uuid())
  nodeType         String         @default("task")
  pattern          String         @default("task")
  parentId         String?
  title            String
  description      String         @default("")
  status           String?
  priority         String?
  estimatedMinutes Int?
  tags             Json           @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  dueDate          DateTime?
  scheduledDate    DateTime?
  scheduledEndDate DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  repeatRule       Json?
  order            Int            @default(0)

  motivation       String?
  successCriteria  String?
  targetDate       DateTime?
  goalStatus       String?
  activePlanId     String?
  isRootGoal       Boolean?       @default(false)
  isSystemTask     Boolean?       @default(false)

  versionWall      Int            @default(0)
  versionCounter   Int            @default(0)
  versionNode      String         @default("")
  deletedAtWall    Int?
  deletedAtCounter Int?
  deletedAtNode    String?

  parent           Todo?          @relation("TodoChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children         Todo[]         @relation("TodoChildren")
  outgoingRelations TodoRelation[] @relation("FromTodo")
  incomingRelations TodoRelation[] @relation("ToTodo")
  logs             TodoLog[]
}

model TodoRelation {
  id         String   @id @default(uuid())
  fromTodoId String
  toTodoId   String
  type       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  versionWall      Int            @default(0)
  versionCounter   Int            @default(0)
  versionNode      String         @default("")
  deletedAtWall    Int?
  deletedAtCounter Int?
  deletedAtNode    String?

  fromTodo   Todo     @relation("FromTodo", fields: [fromTodoId], references: [id], onDelete: Cascade)
  toTodo     Todo     @relation("ToTodo", fields: [toTodoId], references: [id], onDelete: Cascade)
}

model TodoLog {
  id           String   @id @default(uuid())
  todoId       String
  type         String
  content      String
  minutesSpent Int?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  versionWall      Int            @default(0)
  versionCounter   Int            @default(0)
  versionNode      String         @default("")
  deletedAtWall    Int?
  deletedAtCounter Int?
  deletedAtNode    String?

  todo         Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
}

model TimerSession {
  id             String   @id @default(uuid())
  type           String
  name           String
  pluseId        String?
  todoId         String?
  intervals      Json?
  repeatCount    Int      @default(1)
  startedAt      DateTime @default(now())
  pausedAt       DateTime?
  completedAt    DateTime?
  currentIndex   Int      @default(0)
  elapsedSeconds Int      @default(0)
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  versionWall      Int            @default(0)
  versionCounter   Int            @default(0)
  versionNode      String         @default("")
  deletedAtWall    Int?
  deletedAtCounter Int?
  deletedAtNode    String?
}

model Plan {
  id         String   @id @default(uuid())
  goalTodoId String
  title      String
  nodeIds    Json
  edgeIds    Json
  isSystemPlan Boolean? @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  versionWall      Int            @default(0)
  versionCounter   Int            @default(0)
  versionNode      String         @default("")
  deletedAtWall    Int?
  deletedAtCounter Int?
  deletedAtNode    String?

  @@index([goalTodoId])
}

model ActionEdge {
  id         String   @id @default(uuid())
  fromTodoId String
  toTodoId   String
  type       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  versionWall      Int            @default(0)
  versionCounter   Int            @default(0)
  versionNode      String         @default("")
  deletedAtWall    Int?
  deletedAtCounter Int?
  deletedAtNode    String?
}

model Pluse {
  id            String   @id @default(uuid())
  name          String
  description   String   @default("")
  intervals     Json
  repeatCount   Int      @default(1)
  intervalTodos Json?
  autoAdvance   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  versionWall      Int            @default(0)
  versionCounter   Int            @default(0)
  versionNode      String         @default("")
  deletedAtWall    Int?
  deletedAtCounter Int?
  deletedAtNode    String?
}

model RepeatOccurrence {
  id               String   @id
  templateId       String
  date             DateTime
  status           String
  completedAt      DateTime?
  materializedTodoId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  versionWall      Int            @default(0)
  versionCounter   Int            @default(0)
  versionNode      String         @default("")
  deletedAtWall    Int?
  deletedAtCounter Int?
  deletedAtNode    String?

  @@index([templateId])
  @@index([date])
}

model SyncEvent {
  id        String   @id @default(uuid())
  table     String
  operation String
  recordId  String
  payload   Json?
  deviceId  String
  createdAt DateTime @default(now())
  versionWall      Int            @default(0)
  versionCounter   Int            @default(0)
  versionNode      String         @default("")

  @@index([createdAt])
  @@index([recordId])
}

model Device {
  id         String   @id @default(uuid())
  deviceId   String   @unique
  platform   String   // 'ios' | 'watchos' | 'desktop'
  name       String?
  pushToken  String?
  appVersion String?
  lastSeenAt DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([platform])
  @@index([pushToken])
}
